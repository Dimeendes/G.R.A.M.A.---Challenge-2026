require 'json'

package = JSON.parse(File.read(File.join(__dir__, 'package.json')))

# When the host app installs GoogleMaps via Swift Package Manager instead of
# CocoaPods, it can opt out of the pod dependency by adding the following line
# at the top of its Podfile (outside any target block):
#
#     $RNStreetViewUseSPMGoogleMaps = true
#
# See README for full SPM setup instructions.
use_spm_googlemaps = defined?($RNStreetViewUseSPMGoogleMaps) && $RNStreetViewUseSPMGoogleMaps == true

Pod::Spec.new do |s|
  s.name         = package['name']
  s.version      = package['version']
  s.summary      = package['description']
  s.license      = package['license']

  s.authors      = package['author']
  s.homepage     = package['homepage']
  s.platform     = :ios, "12.0"

  s.source       = { :git => "https://github.com/nesterapp/react-native-streetview.git", :tag => "v#{s.version}" }
  s.source_files  = "ios/**/*.{h,m}"

  s.dependency 'React-Core'

  if use_spm_googlemaps
    # GoogleMaps is expected to be linked to the app target by Swift Package Manager.
    # Point the Pods target at the SPM-built GoogleMaps.xcframework so the library
    # sources can still resolve <GoogleMaps/GoogleMaps.h> at compile time, and link
    # against it at link time without duplicating the framework.
    s.pod_target_xcconfig = {
      'FRAMEWORK_SEARCH_PATHS' => [
        '$(inherited)',
        '"$(BUILD_DIR)/../../SourcePackages/artifacts/ios-maps-sdk/GoogleMaps"'
      ].join(' '),
      'OTHER_LDFLAGS' => '$(inherited) -framework "GoogleMaps"'
    }
  else
    s.dependency 'GoogleMaps'
  end
end
